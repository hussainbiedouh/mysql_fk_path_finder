# Environment variables for FK Path Finder
# Copy this file to .env and fill in your values

# MySQL Connection
FK_MYSQL_HOST=localhost
FK_MYSQL_PORT=3306
FK_MYSQL_USER=root
FK_MYSQL_PASSWORD=yourpassword
FK_MYSQL_DATABASE=sakila

# Search Limits
FK_MAX_PATH_LENGTH=6
FK_MAX_PATHS=1000
FK_DISPLAY_LIMIT=20
